# ==================================================
# Academic Regulation and Student Petition Triage Service
# Environment Configuration Template
# ==================================================

# --------------------------------------------------
# Application
# --------------------------------------------------
APP_NAME="Academic Petition Triage Service"
APP_ENV=development
DEBUG=false
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1

# --------------------------------------------------
# Database (SQLite default for development)
# In Docker: sqlite:////app/storage/petitions.db
# --------------------------------------------------
DATABASE_URL=sqlite:///./storage/petitions.db

# --------------------------------------------------
# Redis & Background Queue (RQ)
# In Docker: redis://redis:6379/0
# --------------------------------------------------
REDIS_URL=redis://localhost:6379/0
REDIS_QUEUE_NAME=petition-processing

# --------------------------------------------------
# Vector Store (ChromaDB)
# --------------------------------------------------
CHROMA_HOST=localhost
CHROMA_PORT=8000
CHROMA_COLLECTION_NAME=academic_regulations
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --------------------------------------------------
# LLM Provider Configuration
# --------------------------------------------------
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-120b
# Leave blank or set your actual API key for live inference
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_TEMPERATURE=0.0
LLM_TIMEOUT_SECONDS=30.0

# Set to true for offline / benchmark execution without external LLM calls
USE_STUB_LLM=false
STUB_LLM_LATENCY_MS=100

# --------------------------------------------------
# Agent Execution Limits & Timeouts
# --------------------------------------------------
MAX_AGENT_STEPS=8
MAX_TOOL_CALLS=12
MAX_AGENT_RETRIES=2
MAX_RUN_DURATION_SECONDS=120
TOOL_TIMEOUT_SECONDS=30.0
RETRY_BACKOFF_SECONDS=0.5

# --------------------------------------------------
# Reliability & Circuit Breaker
# --------------------------------------------------
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_RECOVERY_SECONDS=30

# --------------------------------------------------
# Retrieval & Document Chunking
# --------------------------------------------------
RETRIEVAL_TOP_K=5
RETRIEVAL_SCORE_THRESHOLD=0.0
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
PROMPT_VERSION=v1

# --------------------------------------------------
# Observability (Prometheus, OpenTelemetry, Jaeger)
# In Docker: http://jaeger:4317
# --------------------------------------------------
OTEL_SERVICE_NAME=academic-petition-triage
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
METRICS_ENABLED=true

# --------------------------------------------------
# API Protection & Rate Limiting
# --------------------------------------------------
RATE_LIMIT_PER_MINUTE=30

# --------------------------------------------------
# Grafana Credentials (required by Docker Compose)
# --------------------------------------------------
GRAFANA_ADMIN_PASSWORD=admin_change_in_production
